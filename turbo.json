{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "OPENAI_API_KEY",
        "STRIPE_API_KEY",
        "THREE_CREDITS",
        "STRIPE_WEBHOOK_SECRET",
        "SITE_URL",
        "OPENROUTER_API_KEY",
        "LANGCHAIN_TRACING_V2",
        "LANGCHAIN_ENDPOINT",
        "LANGCHAIN_API_KEY",
        "CLERK_SECRET_KEY",
        "DISCORD_WEBHOOK_URL",
        "DATABASE_URL",
        "ONE_CREDIT"
      ]
    },
    "@sideproject-ai/api#deploy": {
      "dependsOn": []
    },
    "deploy": {
      "dependsOn": ["build", "test", "lint"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
